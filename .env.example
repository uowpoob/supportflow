# 复制为根目录 .env，然后填写本地密钥；不要提交真实密钥。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_project

# 登录会话有效期，默认 24 小时；生产 HTTPS 环境必须将 SECURE 设为 true。
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼（DashScope）文本向量，走 OpenAI 兼容模式
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# 可选 2048 / 1536 / 1024(默认) / 768 / 512 / 256 / 128 / 64
EMBEDDING_DIM=1024

# Milvus：显式调用 init_milvus() 时才连接并检查库和集合。
MILVUS_URI=http://127.0.0.1:19530
DB_NAME=supportflow
COLLECTION=supportflow_knowledge

# 阿里云百炼文本重排（rerank），走原生接口，与上面的兼容模式地址不同。
# 完整端点为 该地址 + /services/rerank/text-rerank/text-rerank，复用 DASHSCOPE_API_KEY。
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_MODEL=gte-rerank-v2

# 开启追踪需要填写 LANGSMITH_API_KEY；这里只读取配置，尚未接入 SDK。
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supportflow
